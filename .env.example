```javascript
// backend/index.js
// Jagdamba Opticals Backend — Node.js with Express

const express = require('express');
const cors = require('cors');
const fs = require('fs');
const path = require('path');
const nodemailer = require('nodemailer');
const twilio = require('twilio');
require('dotenv').config();

const app = express();
const PORT = process.env.PORT || 3000;

// ---------- Middleware ----------
app.use(cors());
app.use(express.json());

// ---------- Simple file-based storage (since no DB) ----------
const DATA_DIR = path.join(__dirname, 'data');
if (!fs.existsSync(DATA_DIR)) fs.mkdirSync(DATA_DIR);

const VISITS_FILE = path.join(DATA_DIR, 'visits.json');
const LEADS_FILE = path.join(DATA_DIR, 'leads.json');
const BOOKINGS_FILE = path.join(DATA_DIR, 'bookings.json');

// Helper: read/write JSON files
const readJSON = (file) => {
  try {
    if (fs.existsSync(file)) {
      return JSON.parse(fs.readFileSync(file, 'utf8'));
    }
  } catch (e) {}
  return [];
};

const writeJSON = (file, data) => {
  fs.writeFileSync(file, JSON.stringify(data, null, 2), 'utf8');
};

// ---------- Email transporter (Gmail) ----------
let transporter = null;
if (process.env.GMAIL_USER && process.env.GMAIL_APP_PASSWORD) {
  transporter = nodemailer.createTransport({
    service: 'gmail',
    auth: {
      user: process.env.GMAIL_USER,
      pass: process.env.GMAIL_APP_PASSWORD,
    },
  });
  console.log('✓ Email transporter ready');
} else {
  console.warn('⚠ Gmail credentials not set — email alerts disabled');
}

// ---------- Twilio client ----------
let twilioClient = null;
if (process.env.TWILIO_ACCOUNT_SID && process.env.TWILIO_AUTH_TOKEN) {
  twilioClient = twilio(
    process.env.TWILIO_ACCOUNT_SID,
    process.env.TWILIO_AUTH_TOKEN
  );
  console.log('✓ Twilio client ready');
} else {
  console.warn('⚠ Twilio credentials not set — WhatsApp alerts disabled');
}

// ---------- Notification function ----------
async function sendNotifications(booking) {
  const subject = `📋 New Booking: ${booking.fname}`;
  const text = `
New booking request:

Name:     ${booking.fname}
Phone:    ${booking.fphone}
Email:    ${booking.femail || '(not provided)'}
Service:  ${booking.fservice}
Date:     ${booking.fdate}
Notes:    ${booking.fnote || '(none)'}

Source: Jagdamba Opticals website
`;

  // --- Email ---
  if (transporter) {
    const to = process.env.NOTIFY_EMAIL || process.env.GMAIL_USER;
    try {
      await transporter.sendMail({
        from: process.env.GMAIL_USER,
        to,
        subject,
        text,
      });
      console.log(`📧 Email notification sent to ${to}`);
    } catch (err) {
      console.error('❌ Email send failed:', err.message);
    }
  }

  // --- WhatsApp ---
  if (twilioClient && process.env.TWILIO_WHATSAPP_FROM && process.env.NOTIFY_WHATSAPP_TO) {
    try {
      await twilioClient.messages.create({
        from: `whatsapp:${process.env.TWILIO_WHATSAPP_FROM}`,
        to: `whatsapp:${process.env.NOTIFY_WHATSAPP_TO}`,
        body: text,
      });
      console.log(`📱 WhatsApp notification sent to ${process.env.NOTIFY_WHATSAPP_TO}`);
    } catch (err) {
      console.error('❌ WhatsApp send failed:', err.message);
    }
  }
}

// ---------- Routes ----------

// Health check
app.get('/api/health', (req, res) => {
  res.json({ status: 'ok', timestamp: new Date().toISOString() });
});

// ---------- Track visits ----------
app.post('/api/visits', (req, res) => {
  const { page, referrer, screen } = req.body;
  const visits = readJSON(VISITS_FILE);
  visits.push({
    page: page || '/',
    referrer: referrer || '',
    screen: screen || '',
    timestamp: new Date().toISOString(),
    ip: req.ip || req.connection.remoteAddress,
    userAgent: req.get('User-Agent') || '',
  });
  writeJSON(VISITS_FILE, visits);
  res.json({ success: true });
});

// ---------- Lead capture ----------
app.post('/api/leads', async (req, res) => {
  const { name, phone, page } = req.body;
  if (!name || !phone) {
    return res.status(400).json({ error: 'Name and phone are required' });
  }

  const leads = readJSON(LEADS_FILE);
  const lead = {
    name,
    phone,
    page: page || '/',
    timestamp: new Date().toISOString(),
    ip: req.ip || req.connection.remoteAddress,
  };
  leads.push(lead);
  writeJSON(LEADS_FILE, leads);

  // Send notification for leads too (lighter)
  const subject = `📱 New Lead: ${name}`;
  const text = `
New lead captured:

Name:  ${name}
Phone: ${phone}
Page:  ${page || '(not specified)'}

Source: Jagdamba Opticals website
`;

  if (transporter) {
    const to = process.env.NOTIFY_EMAIL || process.env.GMAIL_USER;
    try {
      await transporter.sendMail({
        from: process.env.GMAIL_USER,
        to,
        subject,
        text,
      });
      console.log(`📧 Lead notification sent to ${to}`);
    } catch (err) {
      console.error('❌ Lead email failed:', err.message);
    }
  }

  if (twilioClient && process.env.TWILIO_WHATSAPP_FROM && process.env.NOTIFY_WHATSAPP_TO) {
    try {
      await twilioClient.messages.create({
        from: `whatsapp:${process.env.TWILIO_WHATSAPP_FROM}`,
        to: `whatsapp:${process.env.NOTIFY_WHATSAPP_TO}`,
        body: text,
      });
      console.log(`📱 Lead WhatsApp sent to ${process.env.NOTIFY_WHATSAPP_TO}`);
    } catch (err) {
      console.error('❌ Lead WhatsApp failed:', err.message);
    }
  }

  res.json({ success: true });
});

// ---------- Booking ----------
app.post('/api/bookings', async (req, res) => {
  const { fname, fphone, femail, fservice, fdate, fnote } = req.body;
  if (!fname || !fphone || !fservice || !fdate) {
    return res.status(400).json({ error: 'Missing required fields' });
  }

  const booking = {
    id: Date.now().toString(36) + Math.random().toString(36).slice(2, 7),
    fname,
    fphone,
    femail: femail || '',
    fservice,
    fdate,
    fnote: fnote || '',
    timestamp: new Date().toISOString(),
    ip: req.ip || req.connection.remoteAddress,
    userAgent: req.get('User-Agent') || '',
  };

  const bookings = readJSON(BOOKINGS_FILE);
  bookings.push(booking);
  writeJSON(BOOKINGS_FILE, bookings);

  // Send notifications
  await sendNotifications(booking);

  res.json({ success: true, bookingId: booking.id });
});

// ---------- Analytics (admin only) ----------
function requireAdmin(req, res, next) {
  const key = req.query.key || req.headers['x-admin-key'];
  if (key !== process.env.ADMIN_KEY) {
    return res.status(401).json({ error: 'Unauthorized — missing or invalid admin key' });
  }
  next();
}

app.get('/api/visits', requireAdmin, (req, res) => {
  const visits = readJSON(VISITS_FILE);
  res.json({ count: visits.length, data: visits.slice(-500) });
});

app.get('/api/leads', requireAdmin, (req, res) => {
  const leads = readJSON(LEADS_FILE);
  res.json({ count: leads.length, data: leads.slice(-500) });
});

app.get('/api/bookings', requireAdmin, (req, res) => {
  const bookings = readJSON(BOOKINGS_FILE);
  res.json({ count: bookings.length, data: bookings.slice(-500) });
});

app.get('/api/analytics', requireAdmin, (req, res) => {
  const visits = readJSON(VISITS_FILE);
  const leads = readJSON(LEADS_FILE);
  const bookings = readJSON(BOOKINGS_FILE);

  // Simple stats
  const today = new Date().toISOString().slice(0, 10);
  const todayVisits = visits.filter(v => v.timestamp && v.timestamp.startsWith(today));
  const todayLeads = leads.filter(v => v.timestamp && v.timestamp.startsWith(today));
  const todayBookings = bookings.filter(v => v.timestamp && v.timestamp.startsWith(today));

  // Top pages
  const pageCounts = {};
  visits.forEach(v => {
    const p = v.page || '/';
    pageCounts[p] = (pageCounts[p] || 0) + 1;
  });
  const topPages = Object.entries(pageCounts)
    .sort((a, b) => b[1] - a[1])
    .slice(0, 10);

  res.json({
    totals: {
      visits: visits.length,
      leads: leads.length,
      bookings: bookings.length,
    },
    today: {
      visits: todayVisits.length,
      leads: todayLeads.length,
      bookings: todayBookings.length,
    },
    topPages,
    last30Days: {
      visits: visits.filter(v => v.timestamp && new Date(v.timestamp) > new Date(Date.now() - 30 * 86400000)).length,
      leads: leads.filter(v => v.timestamp && new Date(v.timestamp) > new Date(Date.now() - 30 * 86400000)).length,
      bookings: bookings.filter(v => v.timestamp && new Date(v.timestamp) > new Date(Date.now() - 30 * 86400000)).length,
    },
  });
});

// ---------- Start server ----------
app.listen(PORT, () => {
  console.log(`\n🔷 Jagdamba Opticals Backend`);
  console.log(`   Running on http://localhost:${PORT}`);
  console.log(`   Admin endpoints require ?key=... or x-admin-key header`);
  console.log(`   Data stored in ${DATA_DIR}\n`);
});
```

